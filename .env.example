# FlashSeat Environment Configuration
DATABASE_URL=sqlite+aiosqlite:///./flashseat.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/flashseat_db

REDIS_URL=redis://localhost:6379/0
SEAT_HOLD_TTL_SECONDS=600
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
